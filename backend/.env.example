# ====================================================================
# SILCAR INDUSTRIAL OS — ARCHIVO DE EJEMPLO DE VARIABLES DE ENTORNO
# ====================================================================
# INSTRUCCIONES:
# Para desarrollo local aislado, cree un archivo `.env.local` en esta carpeta (`backend/`)
# y defina la conexión al PostgreSQL local.
# `.env.local` tiene prioridad sobre `.env` y está ignorado en Git (.gitignore).
# NUNCA copie credenciales de producción en este archivo.
# ====================================================================

# Conexión a PostgreSQL con aislamiento por esquema `silcar`:
# Para Railway: postgresql://<user>:<password>@<host>:<port>/<dbname>?schema=silcar
# Para entorno local: postgresql://silcar_dev:silcar_dev_secret@localhost:5432/silcar_local?schema=silcar
DATABASE_URL="postgresql://silcar_dev:silcar_dev_secret@localhost:5432/silcar_local?schema=silcar"

# Puerto del servidor backend:
PORT=3001

# Entorno:
NODE_ENV=development

# Clave secreta para tokens JWT (generar una cadena segura y única para desarrollo):
JWT_SECRET="silcar_dev_jwt_secret_change_in_production"

# Origen CORS permitido para el frontend Vite:
CORS_ORIGIN="http://localhost:5173"
